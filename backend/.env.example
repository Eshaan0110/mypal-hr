# Copy to backend/.env for local development. Placeholder values only - never commit .env.

# development | test | staging | production  (production disables /api/docs)
MYPAL_ENVIRONMENT=development
MYPAL_LOG_LEVEL=INFO
# true = one JSON object per line; false = readable text for a local terminal
MYPAL_LOG_JSON=false
# JSON list of browser origins allowed to call the API (the frontend dev server, from Phase 6)
MYPAL_CORS_ORIGINS=[]

# REQUIRED. The local Docker Compose database (docker-compose.yml at the repo root).
# Replace CHANGE_ME with the MYPAL_DB_PASSWORD you set in the repo-root .env.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first and stalls.
# For any shared environment, the URL must come from the approved secret store, not a file.
MYPAL_DATABASE_URL=postgresql+psycopg://mypal:CHANGE_ME@127.0.0.1:5432/mypal
# Used only by the test suite; the tests create and drop all tables in this database.
MYPAL_TEST_DATABASE_URL=postgresql+psycopg://mypal:CHANGE_ME@127.0.0.1:5432/mypal_test

# --- Phase 4: search index and language model ---
# Same value as MYPAL_QDRANT_API_KEY in the repo-root .env.
MYPAL_QDRANT_API_KEY=CHANGE_ME
# Local Ollama (OpenAI-compatible API). No key needed for Ollama.
MYPAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
MYPAL_LLM_MODEL=qwen3.5:9b
