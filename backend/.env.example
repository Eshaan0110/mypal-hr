# Copy to backend/.env for local development. Placeholder values only - never commit .env.
# Every variable is optional; the defaults are shown.

# development | test | staging | production  (production disables /api/docs)
MYPAL_ENVIRONMENT=development
MYPAL_LOG_LEVEL=INFO
# true = one JSON object per line; false = readable text for a local terminal
MYPAL_LOG_JSON=false
# JSON list of browser origins allowed to call the API (the frontend dev server, from Phase 6)
MYPAL_CORS_ORIGINS=[]
