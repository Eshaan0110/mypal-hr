# Copy to .env (repo root) for Docker Compose. Never commit .env.
# Choose your own local values; the services are only reachable from this machine.
# Use the same values in backend/.env.
# Letters and digits only for the password: it is also placed inside a database URL.
MYPAL_DB_PASSWORD=CHANGE_ME
MYPAL_QDRANT_API_KEY=CHANGE_ME

# Optional. Host ports, if the defaults are already in use on this machine.
# MYPAL_DB_PORT=5432
# MYPAL_QDRANT_PORT=6333
# MYPAL_WEB_PORT=8080

# Optional, for "docker compose --profile app": the language model the backend container uses.
# Default: Ollama on this machine. IT's hosted OpenAI-compatible endpoint would go here.
# MYPAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# MYPAL_LLM_MODEL=qwen3.5:9b
# MYPAL_LLM_API_KEY=CHANGE_ME
